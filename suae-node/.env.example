# ==========================================
# Study UAE - Backend API Environment Variables
# ==========================================

# Server Configuration
NODE_ENV=development
APP_PORT=5000
PORT=5000

# Base URLs
BASE_URL=http://localhost:5000/
BASE_URL_LOCAL=http://localhost:5000/
FRONTEND_URL=http://localhost:3000
APPLICANT_PANEL_URL=http://localhost:3000/

# Database Connection (MySQL / MariaDB)
# Option 1: Individual Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=study_uae_db
DB_SSL=false

# Option 2: Full Connection String (Render / Cloud DB)
# DATABASE_URL=mysql://user:pass@host:port/dbname

# File Storage Configuration
UP_PATH=uploads
UP_URL=http://localhost:5000/uploads/

# Security & Global Authentication
GLOBAL_PASS=your_secure_global_admin_password_hash
JWT_SECRET=your_jwt_secret_key_change_in_production

# Optional Integrations
# WhatsApp Cloud API (optional for notifications)
WHATSAPP_API_ENDPOINT=
WHATSAPP_API_TOKEN=

# External PHP Legacy API (if needed)
PHP_API_ENDPOINT=

# HTTPS Configuration (Set to true only when using custom local SSL certificates)
USE_HTTPS=false
# SSL_KEY_PATH=ssl/key.key
# SSL_CERT_PATH=ssl/crt.crt
# SSL_BUNDLE_PATH=ssl/bundle.crt
