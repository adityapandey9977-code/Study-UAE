# Backend API Endpoint (Point to your deployed Render backend or http://localhost:5000)
VITE_NODE_API_URL=http://localhost:5000

# Student Login URL (Point to your deployed Vercel frontend or http://localhost:3000/student-login)
VITE_STUDENT_LOGIN_URL=http://localhost:3000/student-login

# Optional: Institute Login URL
VITE_INSTITUTE_LOGIN_URL=http://localhost:3000/institute-login
