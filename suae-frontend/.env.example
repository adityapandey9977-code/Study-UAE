# Backend API Endpoints (Point to your deployed Render backend or localhost:5000)
REACT_APP_API_URL_NODE=http://localhost:5000/
REACT_APP_API_URL=http://localhost:5000/
REACT_APP_UPLOADS_URL=http://localhost:5000/uploads/

# Public Landing Website URL
REACT_APP_WEBSITE_URL=http://localhost:5173

# Optional: Google reCAPTCHA Site Key (if enabled)
REACT_APP_RECAPTCHA_SITE_KEY=
